{
  "name": "rpg-tabletop",
  "version": "2.8.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "server",
    "client",
    "desktop"
  ],
  "scripts": {
    "dev": "concurrently -k -n server,client -c yellow,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "node scripts/build.mjs",
    "start": "node dist/server.cjs",
    "typecheck": "tsc -p shared && tsc -p server && tsc -p client && tsc -p desktop",
    "test": "npm test -w server",
    "package": "node scripts/package.mjs",
    "icon": "node scripts/make-icon.mjs",
    "app": "node scripts/package.mjs --run"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.3"
  }
}
